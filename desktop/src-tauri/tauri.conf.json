{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Recorder",
  "version": "0.1.0",
  "identifier": "ge.stretching.audiorecorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Запись рабочего дня",
        "width": 440,
        "height": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
