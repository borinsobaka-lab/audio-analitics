# Настройки сборки приложения записи.
#
# Скопируйте этот файл рядом под именем build.env и подставьте свои значения:
#
#     cp build.env.example build.env
#
# После этого приложение соберётся уже знающим, куда ходить, и у сотрудника
# на ресепшене останется одна настройка — «Точка продажи».
#
# build.env в git не попадает: в нём лежит ключ.

# Адрес сервера — тот же, что открывается как https://…/health
AA_SERVER_URL=https://api-audio.example.com

# APP_KEY — ровно то же значение, что стоит в переменных окружения сервера
AA_APP_KEY=
