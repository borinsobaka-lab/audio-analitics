# Copy to backend/.env and fill in. Never commit real values.

ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# Supabase Postgres: Settings → Database → Connection string (use the direct
# connection or session pooler, NOT the transaction pooler — Celery needs
# regular connections). Replace the driver prefix with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Redis (docker-compose provides one on the Hetzner server)
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2: dashboard → R2 → Manage API tokens
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=audio-analytics
S3_REGION=auto

# ElevenLabs (ASR)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2

# OpenAI — ИИ-помощник в «Скриптах» (подбор скрипта / ответ клиенту).
# Модель можно сменить в админке: «Скрипты» → «Настройки» → «ИИ-помощник».
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (LLM analysis). Та же модель разбирает CRM: переписки и движение
# сделок (модель для CRM можно сменить в админке: «CRM» → «Настройки»).
ANTHROPIC_API_KEY=
# Stage 1 — деление смены на диалоги и итог дня, stage 2 — оценка по метрикам
# и разбор CRM. Haiku 5.5 в 20 раз дешевле Sonnet 5. Если оценки по метрикам
# окажутся слабее, верните claude-sonnet-5 только в LLM_MODEL_STAGE2.
LLM_MODEL_STAGE1=claude-haiku-5-5
LLM_MODEL_STAGE2=claude-haiku-5-5
# Лимит ответа модели (размышления и ответ вместе). Ниже 16000 длинный блок
# сегментации обрезается, и день уходит в ошибку.
LLM_MAX_TOKENS=16000
# Сегментация дня идёт блоками не длиннее этого числа символов транскрипта;
# режется только по паузам длиннее CONVERSATION_GAP_S.
LLM_STAGE1_BLOCK_CHARS=40000
# Все метрики диалога оцениваются одним запросом; инструкции метрик набираются
# в запрос до этого числа символов, остальные идут следующим запросом.
LLM_METRICS_BATCH_CHARS=60000
# Диалоги короче этого числа реплик по метрикам не оцениваются.
LLM_MIN_DIALOG_TURNS=4
# Оценивать ли по метрикам сервисные разговоры (перенос, оплата, расписание).
LLM_METRICS_ON_SERVICE=false

# Тарифы для подсчёта стоимости смены и дня CRM (USD).
# ASR — цена часа аудио. ЗНАЧЕНИЕ НИЖЕ ОРИЕНТИРОВОЧНОЕ: поставьте фактическое
# из своего тарифа ElevenLabs, иначе стоимость в админке будет врать
# убедительно выглядящими цифрами.
PRICE_ASR_PER_HOUR_USD=0.40
# LLM — тарифы моделей Claude вместе с ценой кэша заданы в коде
# (backend/app/pipeline/cost.py). Эти два значения — цена за миллион токенов
# только для модели, которой там нет; по умолчанию прайс Sonnet 5.
PRICE_LLM_INPUT_PER_MTOK_USD=2.00
PRICE_LLM_OUTPUT_PER_MTOK_USD=10.00

# Telegram — сводка разбора CRM в чат владельца и администратора: токен
# бота и id чата (несколько — через запятую). Тот же бот, что у других
# уведомлений. Пусто — сводка не отправляется.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Адрес админки для ссылок в сообщениях (https://admin.example.com).
# Пусто — берётся первый адрес из CORS_ORIGINS.
DASHBOARD_URL=

# Device keys for desktop clients: "key:location_id" comma-separated.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# location_id is printed by: python -m cli.seed
DEVICE_API_KEYS=

# Supabase JWT secret (Settings → API → JWT Secret) for dashboard auth.
# Empty in development = auth disabled.
SUPABASE_JWT_SECRET=

# Pipeline tuning
VAD_THRESHOLD=0.5
CONVERSATION_GAP_S=30
AUDIO_RETENTION_DAYS=60
# Разбор, статус которого не менялся дольше этого (секунды), считается
# зависшим: в админке появляются «Запустить заново» и «Удалить».
STALE_PROCESSING_S=10800
